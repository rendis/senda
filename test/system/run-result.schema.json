{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senda-app.github.io/schemas/system-run-result.schema.json",
  "title": "System Test Run Result",
  "type": "object",
  "required": [
    "timestamp",
    "mode",
    "artifact_dir",
    "summary",
    "stages",
    "exit_code"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": ["pr", "nightly"]
    },
    "artifact_dir": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "skip"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "duration_ms", "log_path"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "log_path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 1]
    }
  },
  "additionalProperties": false
}
