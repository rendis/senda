  "components": {
    "securitySchemes": {
      "WorkspaceAPIKeyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "senda_prod|senda_test",
        "description": "Workspace-scoped API key sent as Authorization: Bearer senda_prod_... or senda_test_..."
      }
    },
    "schemas": {
      "SendEmailRequest": {
        "type": "object",
        "required": [
          "ref",
          "to"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Template ref in tenant:workspace:template_type format."
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "variables": {
            "type": "object",
            "additionalProperties": true
          },
          "external_id": {
            "type": "string",
            "description": "Caller-provided correlation or idempotency identifier."
          },
          "locale": {
            "type": "string",
            "description": "BCP-47 locale such as en or es-419."
          }
        }
      },
      "SendEmailResponse": {
        "type": "object",
        "required": [
          "status",
          "tracking_ids",
          "template_resolved",
          "template_version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "queued"
          },
          "tracking_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackingEntryResponse"
            }
          },
          "external_id": {
            "type": "string"
          },
          "template_resolved": {
            "type": "string"
          },
          "template_version": {
            "type": "integer"
          }
        }
      },
      "SendBatchRequest": {
        "type": "object",
        "required": [
          "ref",
          "items"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Shared template ref in tenant:workspace:template_type format."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SendBatchItemRequest"
            }
          }
        }
      },
      "SendBatchItemRequest": {
        "type": "object",
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "type": "string",
            "format": "email"
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "variables": {
            "type": "object",
            "additionalProperties": true
          },
          "external_id": {
            "type": "string",
