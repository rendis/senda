{
  "openapi": "3.0.3",
  "info": {
    "title": "Senda Workspace API Key Reference",
    "version": "1.0.0",
    "description": "Interactive reference for every Senda endpoint available to workspace API key clients."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Senda deployment"
    }
  ],
  "tags": [
    {
      "name": "send",
      "description": "Queue outbound emails through the workspace data plane."
    },
    {
      "name": "emails",
      "description": "Query workspace email records, event history, and CSV exports."
    }
  ],
  "paths": {
    "/api/v1/send": {
      "post": {
        "tags": [
          "send"
        ],
        "summary": "Queue an email send",
        "description": "Send an email using a workspace-scoped API key. Each recipient gets its own tracking ID.",
        "security": [
          {
            "WorkspaceAPIKeyBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailRequest"
              },
              "example": {
                "ref": "acme:production:welcome-email",
                "to": [
                  "user@example.com"
                ],
                "cc": [],
                "bcc": [],
                "variables": {
                  "first_name": "Jane",
                  "activation_url": "https://app.example.com/activate?token=xyz"
                },
                "external_id": "signup-jane-20260226",
                "locale": "en"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/send/batch": {
      "post": {
        "tags": [
          "send"
        ],
        "summary": "Queue a same-template batch send",
        "description": "Send a same-template batch using a workspace-scoped API key. Each item resolves its own variables and injectors and returns its own status and tracking ID.",
        "security": [
          {
            "WorkspaceAPIKeyBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendBatchRequest"
              },
              "example": {
                "ref": "acme:production:welcome-email",
                "items": [
                  {
                    "to": "ana@example.com",
                    "variables": {
                      "first_name": "Ana",
                      "activation_url": "https://app.example.com/activate?token=ana"
                    },
                    "external_id": "signup-ana-1",
                    "locale": "es"
                  },
                  {
                    "to": "bob@example.com",
                    "variables": {
                      "first_name": "Bob",
                      "activation_url": "https://app.example.com/activate?token=bob"
                    },
                    "external_id": "signup-bob-2",
                    "locale": "en"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendBatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited",
